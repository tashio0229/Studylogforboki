filters:
  and:
    - file.inFolder("secretary/study/問題ノート")
    - 'flagged == true'

properties:
  id:
    displayName: "問題ID"
  subtitle:
    displayName: "副題"
  chapter:
    displayName: "章"
  grade:
    displayName: "理解度"
  due:
    displayName: "次回復習日"
  reps:
    displayName: "復習回数"

views:
  - type: table
    name: "要対策（章別）"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - id
      - subtitle
      - grade
      - due
      - reps

  - type: table
    name: "要対策（復習回数の多い順＝沼リスト）"
    groupBy:
      property: reps
      direction: DESC
    order:
      - id
      - subtitle
      - chapter
      - grade
      - due
